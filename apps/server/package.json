{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc --noEmit",
    "compile": "bun build --compile --no-compile-autoload-dotenv --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "start": "bun run dist/index.mjs",
    "env:generate": "varlock codegen"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/trpc": "^1.1.0",
    "@hono/trpc-server": "^0.4.2",
    "@hospiledger/api": "workspace:*",
    "@hospiledger/db": "workspace:*",
    "@hospiledger/shared": "workspace:*",
    "@sinclair/typebox": "^0.34.52",
    "@solana-program/memo": "^0.14.1",
    "@solana/kit": "^8.3.0",
    "@supabase/supabase-js": "^2.116.0",
    "@trpc/server": "catalog:",
    "elysia": "^1.4.30",
    "varlock": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@hospiledger/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.23.0",
    "typescript": "catalog:"
  }
}
